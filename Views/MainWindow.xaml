<Window x:Class="HomeAssistantDesktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:HomeAssistantDesktop"
        Title="{x:Static res:Strings.AppTitle}"
        xmlns:res="clr-namespace:HomeAssistantDesktop.Resources"
        MinWidth="100" MinHeight="80"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBackground}"
        Loaded="MainWindow_Loaded"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackground" Color="#1b1b1f"/>
        <SolidColorBrush x:Key="ChromeBackground" Color="#23232a"/>
        <SolidColorBrush x:Key="Accent" Color="#03a9f4"/>
        <SolidColorBrush x:Key="TextBrush" Color="#e8e8ea"/>
        <SolidColorBrush x:Key="SubtleText" Color="#9a9aa2"/>
        <local:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Compact native title bar -->
        <Border Grid.Row="0" Background="{DynamicResource ChromeBackground}" BorderBrush="#000" BorderThickness="0,0,0,1">
            <Grid Margin="8,4">
                <TextBlock Text="{Binding ActiveServerName}" VerticalAlignment="Center"
                           HorizontalAlignment="Left" Foreground="{DynamicResource TextBrush}" FontSize="13"/>
            </Grid>
        </Border>

        <!-- WebView2 host -->
        <Grid Grid.Row="1">
            <wv2:WebView2 x:Name="WebView"
                          MinWidth="0" MinHeight="0"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

            <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                         Background="Transparent" Foreground="{DynamicResource Accent}"/>

            <!-- Setup overlay (first run) -->
            <Border Background="#1b1b1f" Visibility="{Binding IsFirstRun, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400">
                    <TextBlock Text="{x:Static res:Strings.AppTitle}" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{x:Static res:Strings.Setup_Subtitle}"
                               Margin="0,16,0,0" FontSize="13" Foreground="{DynamicResource SubtleText}"
                               HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                    <TextBox Text="{Binding SetupUrl, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,20,0,0" Height="36" FontSize="14"
                             Background="#2a2a32" Foreground="{DynamicResource TextBrush}"
                             BorderBrush="#3a3a42" BorderThickness="1"
                             HorizontalContentAlignment="Center"/>
                    <TextBlock Text="{x:Static res:Strings.Setup_UrlPlaceholder}"
                               Margin="0,6,0,0" FontSize="11" Foreground="#666"
                               HorizontalAlignment="Center"/>
                    <Button Content="{x:Static res:Strings.Setup_Connect}" Margin="0,16,0,0" Height="36" Width="140"
                            Command="{Binding SetupCommand}"
                            Background="{DynamicResource Accent}" Foreground="White" BorderThickness="0"
                            HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding ErrorText}" Margin="0,12,0,0" FontSize="12"
                               Foreground="#f44336" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Visibility="{Binding SetupError, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>

            <!-- Error overlay -->
            <Border Background="#1b1b1f" Visibility="{Binding ShowError, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                    <TextBlock Text="{x:Static res:Strings.Error_OfflineTitle}" FontSize="18" Foreground="{DynamicResource TextBrush}"
                               HorizontalAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ErrorText}" Margin="0,12,0,0" FontSize="13"
                               Foreground="{DynamicResource SubtleText}" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock Margin="0,8,0,0" FontSize="12" HorizontalAlignment="Center">
                        <Hyperlink NavigateUri="{Binding WebView2DownloadLink}">
                            <Run Text="Download WebView2 Runtime"/>
                        </Hyperlink>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                        <Button Content="{x:Static res:Strings.Error_Retry}" Width="100" Height="32" Margin="6,0" Click="Retry_Click"
                                Background="{DynamicResource Accent}" Foreground="White" BorderThickness="0"/>
                        <Button Content="{x:Static res:Strings.Error_Settings}" Width="100" Height="32" Margin="6,0" Click="ErrorSettings_Click"
                                Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderBrush="#3a3a42"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
