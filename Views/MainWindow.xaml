<Window x:Class="HomeAssistantDesktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HomeAssistantDesktop.ViewModels"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:HomeAssistantDesktop"
        Title="Home Assistant Desktop"
        MinWidth="100" MinHeight="80"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBackground}"
        Loaded="MainWindow_Loaded"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackground" Color="#1b1b1f"/>
        <SolidColorBrush x:Key="ChromeBackground" Color="#23232a"/>
        <SolidColorBrush x:Key="Accent" Color="#03a9f4"/>
        <SolidColorBrush x:Key="TextBrush" Color="#e8e8ea"/>
        <SolidColorBrush x:Key="SubtleText" Color="#9a9aa2"/>
        <local:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Compact native title bar -->
        <Border Grid.Row="0" Background="{DynamicResource ChromeBackground}" BorderBrush="#000" BorderThickness="0,0,0,1">
            <Grid Margin="8,4">
                <TextBlock Text="{Binding ActiveServerName}" VerticalAlignment="Center"
                           HorizontalAlignment="Left" Foreground="{DynamicResource TextBrush}" FontSize="13"/>
            </Grid>
        </Border>

        <!-- WebView2 host -->
        <Grid Grid.Row="1">
            <wv2:WebView2 x:Name="WebView"
                          MinWidth="0" MinHeight="0"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

            <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                         Background="Transparent" Foreground="{DynamicResource Accent}"/>

            <!-- Error overlay -->
            <Border Background="#1b1b1f" Visibility="{Binding ShowError, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                    <TextBlock Text="⚠ Home Assistant is unavailable" FontSize="18" Foreground="{DynamicResource TextBrush}"
                               HorizontalAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ErrorText}" Margin="0,12,0,0" FontSize="13"
                               Foreground="{DynamicResource SubtleText}" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                        <Button Content="Retry" Width="100" Height="32" Margin="6,0" Click="Retry_Click"
                                Background="{DynamicResource Accent}" Foreground="White" BorderThickness="0"/>
                        <Button Content="Settings" Width="100" Height="32" Margin="6,0" Click="ErrorSettings_Click"
                                Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderBrush="#3a3a42"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
