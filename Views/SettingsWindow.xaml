<Window x:Class="HomeAssistantDesktop.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HomeAssistantDesktop.ViewModels"
        xmlns:local="clr-namespace:HomeAssistantDesktop"
        xmlns:res="clr-namespace:HomeAssistantDesktop.Resources"
        Title="{x:Static res:Strings.Settings_Title}"
        Width="520" Height="540" MinWidth="480" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="#1b1b1f" Foreground="#e8e8ea">

    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Switch-style ToggleButton -->
        <Style x:Key="SwitchToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Track" Width="46" Height="24" CornerRadius="12"
                                    Background="#3a3a42"/>
                            <Ellipse x:Name="Knob" Width="18" Height="18" Fill="White"
                                     HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#03a9f4"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#03a9f4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="Height" Value="32"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2a2a32"/>
            <Setter Property="Foreground" Value="#e8e8ea"/>
            <Setter Property="BorderBrush" Value="#3a3a42"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Height" Value="34"/>
        </Style>

        <!-- Consistent setting row: label left, control right -->
        <Style x:Key="SettingRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#03a9f4"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9a9aa2"/>
            <Setter Property="Margin" Value="0,8,0,3"/>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#e8e8ea"/>
            <Setter Property="BorderBrush" Value="#3a3a42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinWidth" Value="64"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#b3261e"/>
        </Style>
        <Style x:Key="ServerAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#e8e8ea"/>
            <Setter Property="BorderBrush" Value="#3a3a42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style x:Key="ServerActionDanger" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#b3261e"/>
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
            <StackPanel>

                <TextBlock Text="{x:Static res:Strings.Settings_StartupSection}" Style="{StaticResource SectionHeader}"/>
                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static res:Strings.Settings_StartWithWindows}" VerticalAlignment="Center"/>
                    <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}" IsChecked="{Binding StartWithWindows}"/>
                </Grid>


                <TextBlock Text="{x:Static res:Strings.Settings_WindowSection}" Style="{StaticResource SectionHeader}"/>
                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static res:Strings.Settings_AlwaysOnTop}" VerticalAlignment="Center"/>
                    <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}" IsChecked="{Binding AlwaysOnTop}"/>
                </Grid>


                <TextBlock Text="{x:Static res:Strings.Settings_ServersSection}" Style="{StaticResource SectionHeader}"/>
                <ListBox ItemsSource="{Binding Servers}" Background="#2a2a32" BorderBrush="#3a3a42"
                         BorderThickness="1" MaxHeight="150">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Url}" Margin="0,2,0,0" Foreground="#9a9aa2" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <Button Content="{x:Static res:Strings.Settings_Edit}" Style="{StaticResource ServerAction}" Margin="0,0,6,0"
                                            Command="{Binding DataContext.EditServerCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="{x:Static res:Strings.Settings_Test}" Style="{StaticResource ServerAction}" Margin="0,0,6,0"
                                            Command="{Binding DataContext.TestConnectionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="{x:Static res:Strings.Settings_Default}" Style="{StaticResource ServerAction}" Margin="0,0,6,0"
                                            Command="{Binding DataContext.SetDefaultCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="{x:Static res:Strings.Settings_Delete}" Style="{StaticResource ServerActionDanger}" Margin="0"
                                            Command="{Binding DataContext.DeleteServerCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Content="{x:Static res:Strings.Settings_AddServer}" HorizontalAlignment="Left" Margin="0,10,0,0"
                        Style="{StaticResource GhostButton}" Command="{Binding AddServerCommand}"/>

                <!-- Edit panel -->
                <Border Background="#23232a" BorderBrush="#3a3a42" BorderThickness="1" Padding="12,10" Margin="0,10,0,0"
                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.Settings_ServerDetails}" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                        <TextBlock Text="{x:Static res:Strings.Settings_Name}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding EditName}"/>
                        <TextBlock Text="{x:Static res:Strings.Settings_Url}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding EditUrl}"/>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static res:Strings.Settings_SetAsDefault}" VerticalAlignment="Center"/>
                            <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}" IsChecked="{Binding EditIsDefault}"/>
                        </Grid>
                        <TextBlock Text="{Binding TestStatus}" Foreground="#9a9aa2" FontSize="11" Margin="0,6,0,0"
                                   Visibility="{Binding HasTestStatus, Converter={StaticResource BoolToVis}}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="{x:Static res:Strings.Settings_Save}" Command="{Binding SaveServerCommand}" Margin="0,0,8,0"/>
                            <Button Content="{x:Static res:Strings.Settings_Test}" Style="{StaticResource GhostButton}" Command="{Binding TestConnectionEditCommand}" Margin="0,0,8,0"/>
                            <Button Content="{x:Static res:Strings.Settings_Cancel}" Style="{StaticResource GhostButton}" Command="{Binding CancelEditCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="{x:Static res:Strings.Settings_AppearanceNote}"
                           TextWrapping="Wrap" Foreground="#9a9aa2" FontSize="11" Margin="0,18,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
