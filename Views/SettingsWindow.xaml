<Window x:Class="HomeAssistantDesktop.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HomeAssistantDesktop.ViewModels"
        xmlns:local="clr-namespace:HomeAssistantDesktop"
        Title="Settings — Home Assistant Desktop"
        Width="560" Height="680" MinWidth="480" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#1b1b1f" Foreground="#e8e8ea">

    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Switch-style ToggleButton -->
        <Style x:Key="SwitchToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Track" Width="46" Height="24" CornerRadius="12"
                                    Background="#3a3a42"/>
                            <Ellipse x:Name="Knob" Width="18" Height="18" Fill="White"
                                     HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#03a9f4"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#03a9f4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2a2a32"/>
            <Setter Property="Foreground" Value="#e8e8ea"/>
            <Setter Property="BorderBrush" Value="#3a3a42"/>
            <Setter Property="Padding" Value="6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Startup" FontWeight="Bold" FontSize="15" Margin="0,0,0,8" Foreground="#03a9f4"/>
                <DockPanel Margin="0,4">
                    <TextBlock Text="Start with Windows" VerticalAlignment="Center"/>
                    <ToggleButton DockPanel.Dock="Right" Style="{StaticResource SwitchToggle}" IsChecked="{Binding StartWithWindows}"/>
                </DockPanel>
                <DockPanel Margin="0,4">
                    <TextBlock Text="Start minimized" VerticalAlignment="Center"/>
                    <ToggleButton DockPanel.Dock="Right" Style="{StaticResource SwitchToggle}" IsChecked="{Binding StartMinimized}"/>
                </DockPanel>

                <TextBlock Text="Window" FontWeight="Bold" FontSize="15" Margin="0,16,0,8" Foreground="#03a9f4"/>
                <DockPanel Margin="0,4">
                    <TextBlock Text="Always on top" VerticalAlignment="Center"/>
                    <ToggleButton DockPanel.Dock="Right" Style="{StaticResource SwitchToggle}" IsChecked="{Binding AlwaysOnTop}"/>
                </DockPanel>
                <DockPanel Margin="0,4">
                    <TextBlock Text="Minimize on close" VerticalAlignment="Center"/>
                    <ToggleButton DockPanel.Dock="Right" Style="{StaticResource SwitchToggle}" IsChecked="{Binding MinimizeOnClose}"/>
                </DockPanel>
                <DockPanel Margin="0,4">
                    <TextBlock Text="Fullscreen on launch" VerticalAlignment="Center"/>
                    <ToggleButton DockPanel.Dock="Right" Style="{StaticResource SwitchToggle}" IsChecked="{Binding Fullscreen}"/>
                </DockPanel>

                <TextBlock Text="Home Assistant Servers" FontWeight="Bold" FontSize="15" Margin="0,16,0,8" Foreground="#03a9f4"/>
                <ListBox ItemsSource="{Binding Servers}" Background="#2a2a32" BorderBrush="#3a3a42" MaxHeight="200">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Url}" Margin="0,2,0,0" Foreground="#9a9aa2" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Edit" Background="Transparent" Foreground="#e8e8ea" BorderBrush="#3a3a42"
                                            Command="{Binding DataContext.EditServerCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" Margin="2"/>
                                    <Button Content="Test" Background="Transparent" Foreground="#e8e8ea" BorderBrush="#3a3a42"
                                            Command="{Binding DataContext.TestConnectionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" Margin="2"/>
                                    <Button Content="Default" Background="Transparent" Foreground="#e8e8ea" BorderBrush="#3a3a42"
                                            Command="{Binding DataContext.SetDefaultCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" Margin="2"/>
                                    <Button Content="Delete" Background="#b3261e" Foreground="White"
                                            Command="{Binding DataContext.DeleteServerCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" Margin="2"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Content="Add Server" HorizontalAlignment="Left" Margin="0,8,0,0"
                        Command="{Binding AddServerCommand}" Background="Transparent" Foreground="#e8e8ea" BorderBrush="#3a3a42"/>

                <!-- Edit panel -->
                <Border Background="#23232a" BorderBrush="#3a3a42" BorderThickness="1" Padding="12" Margin="0,12,0,0"
                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Server details" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock Text="Name" Foreground="#9a9aa2"/>
                        <TextBox Text="{Binding EditName}" Margin="0,2,0,8"/>
                        <TextBlock Text="URL" Foreground="#9a9aa2"/>
                        <TextBox Text="{Binding EditUrl}" Margin="0,2,0,8"/>
                        <DockPanel>
                            <TextBlock Text="Set as default" VerticalAlignment="Center"/>
                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource SwitchToggle}" IsChecked="{Binding EditIsDefault}"/>
                        </DockPanel>
                        <TextBlock Text="{Binding TestStatus}" Foreground="#9a9aa2" FontSize="11" Margin="0,8,0,0"
                                   Visibility="{Binding HasTestStatus, Converter={StaticResource BoolToVis}}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Save" Command="{Binding SaveServerCommand}" Margin="0,0,6,0"/>
                            <Button Content="Test" Command="{Binding TestConnectionEditCommand}" Background="Transparent" Foreground="#e8e8ea" BorderBrush="#3a3a42" Margin="0,0,6,0"/>
                            <Button Content="Cancel" Command="{Binding CancelEditCommand}" Background="Transparent" Foreground="#e8e8ea" BorderBrush="#3a3a42"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="Appearance is managed by Home Assistant itself. The desktop client does not override Home Assistant themes."
                           TextWrapping="Wrap" Foreground="#9a9aa2" FontSize="11" Margin="0,16,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="1" Content="Close" Width="100" HorizontalAlignment="Right" Margin="0,12,0,0"
                Command="{Binding CloseCommand}" Background="Transparent" Foreground="#e8e8ea" BorderBrush="#3a3a42"/>
    </Grid>
</Window>
